{
  "name": "price-watch",
  "displayName": "Preis-Watch (OpenRouter & OpenCode)",
  "description": "Zeigt die aktuellen Modellpreise von OpenRouter und OpenCode Zen an; eine kostenlose KI (OpenRouter Free) prüft sie stündlich und meldet Preisänderungen.",
  "version": "0.3.0",
  "publisher": "local",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/dbdsanalytics/price-watch-vscode.git"
  },
  "homepage": "https://github.com/dbdsanalytics/price-watch-vscode#readme",
  "bugs": "https://github.com/dbdsanalytics/price-watch-vscode/issues",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "priceWatch.open",
        "title": "Preis-Watch öffnen",
        "category": "Preis-Watch"
      },
      {
        "command": "priceWatch.refresh",
        "title": "Preise jetzt aktualisieren",
        "category": "Preis-Watch"
      },
      {
        "command": "priceWatch.setKey",
        "title": "Konto verbinden",
        "category": "Preis-Watch"
      },
      {
        "command": "priceWatch.connectAccount",
        "title": "Anbieterkonto verbinden",
        "category": "Preis-Watch"
      },
      {
        "command": "priceWatch.disconnectAccount",
        "title": "Anbieterkonto trennen",
        "category": "Preis-Watch"
      },
      {
        "command": "priceWatch.connectOpenRouterManagement",
        "title": "OpenRouter Management Key verbinden",
        "category": "Preis-Watch"
      }
    ],
    "configuration": {
      "title": "Preis-Watch",
      "properties": {
        "priceWatch.checkIntervalHours": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "description": "Wie oft die Preise geprüft werden (in Stunden)."
        },
        "priceWatch.aiEveryHours": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "description": "Mindestabstand zwischen zwei automatischen KI-Kommentaren (in Stunden). Ein manuelles Aktualisieren kommentiert immer. Hinweis: kostenlose OpenRouter-Modelle haben tägliche Limits."
        },
        "priceWatch.aiModel": {
          "type": "string",
          "default": "openrouter/free",
          "description": "Kostenloses KI-Modell für die Preis-Analyse (OpenRouter-Modell-ID)."
        },
        "priceWatch.priceJumpPercent": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "description": "Ab welcher Preisänderung in Prozent ein Hinweis in der Übersicht erscheint."
        }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --external:vscode --outfile=dist/extension.js --format=cjs --platform=node --sourcemap",
    "watch": "esbuild src/extension.ts --bundle --external:vscode --outfile=dist/extension.js --format=cjs --platform=node --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/",
    "package": "bunx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
